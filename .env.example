# ListenBrainz (source des écoutes). Le token utilisateur, visible sur
# https://listenbrainz.org/settings/ , est optionnel : il permet de valider la
# configuration (validate-token) et reste côté serveur. En lecture, l'API
# ListenBrainz est publique : le token n'est pas requis pour synchroniser.
LISTENBRAINZ_USERNAME=your_listenbrainz_username
LISTENBRAINZ_USER_TOKEN=
# Language of artist bios (Wikipedia): English by default (richer Wikipedia)
ARTIST_BIO_LANG=en
# Artist grouping: "main" (default) counts each listen towards the main artist
# only ("Westside Gunn/Keisha Plum" -> "Westside Gunn"), the way Last.fm and
# ListenBrainz canonicalize featurings. When a listen carries a MusicBrainz
# artist MBID, the whole group is keyed by that MBID (like ListenBrainz's
# server-side mapping); otherwise by the main-artist name. No extra API calls:
# only locally stored MBIDs are used. Set to "raw" to count every full artist
# string as its own artist (previous behavior).
# ARTIST_GROUPING=main
# LISTENBRAINZ_API_URL=https://api.listenbrainz.org/1   # autre instance (self-hosted)
# LISTENBRAINZ_WEB_URL=https://listenbrainz.org         # liens affichés dans l'UI
PORT=1533

# Optional: Discogs personal access token for the artist/album links
# (works without a token, but with a lower rate limit).
DISCOGS_TOKEN=

# Synchronization
SYNC_CRON=*/5 * * * *
INTEGRITY_CRON=0 3 * * *
INTEGRITY_MISSING_THRESHOLD=1
SYNC_OVERLAP_SECONDS=86400
LISTENBRAINZ_REQUEST_DELAY_MS=1000
LISTENBRAINZ_REQUEST_TIMEOUT_MS=15000
LISTENBRAINZ_MAX_LISTENS_PER_REQUEST=1000

# MusicBrainz metadata (artist bios, album tracklists, MBIDs). MusicBrainz
# requires at most 1 request/second: keep the delay >= 1000 ms.
MUSICBRAINZ_REQUEST_DELAY_MS=1100

# Dashboard performance
DASHBOARD_CACHE_TTL_MS=300000
STATIC_ASSET_CACHE_SECONDS=300

# Custom leaderboards (ListenBrainz usernames)
LEADERBOARD_CACHE_TTL_MS=900000
LEADERBOARD_PROFILE_TTL_MS=86400000
LEADERBOARD_ALBUM_TTL_MS=2592000000
LEADERBOARD_REQUEST_CONCURRENCY=4
LEADERBOARD_MAX_GROUPS=50
LEADERBOARD_MAX_MEMBERS=20
LEADERBOARD_MAX_RANGE_DAYS=366

# External images and recap generation (Cover Art Archive, Deezer, archive.org)
IMAGE_REQUEST_TIMEOUT_MS=10000
IMAGE_FAILURE_CACHE_MS=600000
METADATA_FAILURE_CACHE_MS=600000
EXTERNAL_REQUEST_CONCURRENCY=4
FRIENDS_CACHE_TTL_MS=300000
SHARE_IMAGE_CONCURRENCY=4
SHARE_MAX_CONCURRENT=2
SHARE_IMAGE_MAX_BYTES=10485760

# Optional: comma-separated origins allowed to call the API from another website.
# Leave empty for same-origin access only.
CORS_ORIGIN=

# Music Assistant ("Écouter" play button). The token is generated in the MA UI
# (Settings → Profile) and is only ever used server-side, never sent to the browser.
# MA_API_URL=http://192.168.195.39:8095/api
# MA_TOKEN=
# Default player when the browser has not chosen one: a queue_id (MA_PLAYER_ID)
# or a player name resolved against the MA player list (MA_DEFAULT_PLAYER,
# defaults to "Squeezelite-MacBook" when unset).
# MA_PLAYER_ID=
# MA_DEFAULT_PLAYER=Squeezelite-MacBook
MA_REQUEST_TIMEOUT_MS=8000
MA_SEARCH_CACHE_TTL_MS=300000
MA_PLAYERS_CACHE_TTL_MS=60000

# PM2 process memory limits
API_MAX_MEMORY=512M
CRON_MAX_MEMORY=256M
